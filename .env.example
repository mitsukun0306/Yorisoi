# Yorisoi の設定。このファイルを .env にコピーして値を入れてください。
# .env は Git に含まれません（.gitignore 済み）。

# --- Instagram（プロアカウント＝ビジネス/クリエイターが必要）---
# Meta for Developers のアプリで「Instagramログインを使ったAPI」を設定し、発行したトークンを入れる
# 権限: instagram_business_basic, instagram_business_manage_comments
#       DMも扱うなら instagram_business_manage_messages を追加して INSTAGRAM_INCLUDE_DMS=1
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_RECENT_MEDIA=10
INSTAGRAM_INCLUDE_DMS=

# --- Gmail（Google Cloud で OAuth クライアントを作成。スコープ gmail.readonly と gmail.send）---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 集める対象（Gmailの検索条件と同じ書き方）
GMAIL_QUERY=in:inbox is:unread category:primary -from:me
GMAIL_MAX_RESULTS=20

# --- Slack（自分用のSlackアプリを作り、ユーザートークン xoxp- を発行）---
# スコープ: search:read, im:read, im:history, users:read, chat:write
SLACK_USER_TOKEN=
SLACK_DM_LIMIT=20

# --- 通知先（何も設定しなければターミナルに表示するだけ）---
# LINE に通知する場合: LINE公式アカウント + Messaging API のチャネルアクセストークンと、自分のユーザーID
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# Discord / Slack / ntfy などのWebhookに通知する場合
# 形式: discord / slack / ntfy / json
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=discord

# --- その他 ---
# APIキー無しで試すときは 1 にする
YORISOI_MOCK=
# YORISOI_DATA_FILE=data/mentions.json
# YORISOI_AUTO_REPLY_FILE=auto-reply.json
